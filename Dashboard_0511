    </div>`;
  } else if(sumEl){sumEl.innerHTML='';}

  // 테이블 — All 선택 시 날짜별 합산 / 개별 캠페인 선택 시 개별 행
  if(val==='all'){
    // 날짜별 합산
    const aggRows=Object.entries(byDt).sort((a,b)=>b[0].localeCompare(a[0])).map(([dt,v])=>{
      const dayRoi=v.spend>0?v.revenue/v.spend:0;
      const statuses=[...new Set(filtered.filter(x=>x.date===dt).map(x=>x.status))];
      const stBadge=statuses.map(s=>`<span class="badge ${s==='ENABLE'?'b-on':'b-off'}">${s}</span>`).join(' ');
      return`<tr>
        <td>${dt}</td>
        <td>${stBadge}</td>
        <td>${fK(v.spend)}</td>
        <td style="color:var(--green)">${fK(v.revenue)}</td>
        <td>${filtered.filter(x=>x.date===dt).reduce((a,x)=>a+x.orders,0)}</td>
        <td class="${rc(dayRoi)}">${dayRoi.toFixed(2)}x</td>
      </tr>`;
    });
    document.getElementById('adBody').innerHTML=aggRows.join('');
  } else {
    // 개별 캠페인 — 날짜별 행
    document.getElementById('adBody').innerHTML=filtered.slice().sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<tr>
      <td>${x.date}</td>
      <td><span class="badge ${x.status==='ENABLE'?'b-on':'b-off'}">${x.status}</span></td>
      <td>${fK(x.spend)}</td>
      <td style="color:var(--green)">${fK(x.revenue)}</td>
      <td>${x.orders}</td>
      <td class="${rc(x.roas)}">${x.roas.toFixed(2)}x</td>
    </tr>`).join('');
  }
}

/* ══ AD CREATIVES ══ */
let CR_SORT={key:'revenue',dir:-1};
let CR_DATA=[];

function renderCreatives(){
  const r=getR();
  const vp=DATA.video.filter(x=>inR(x.date,r));
  const byVideo={};
  vp.forEach(x=>{
    const k=x.video_id;
    if(!byVideo[k])byVideo[k]={video_id:x.video_id,product_id:x.product_id,username:x.username,title:x.title,post_date:x.post_date,days_since:x.days_since,spend:0,revenue:0,orders:0,impressions:0,clicks:0,cvr_sum:0,rows:0,status:x.status};
    byVideo[k].spend+=x.spend;byVideo[k].revenue+=x.revenue;byVideo[k].orders+=x.orders;
    byVideo[k].impressions+=x.impressions;byVideo[k].clicks+=x.clicks;byVideo[k].cvr_sum+=x.cvr;byVideo[k].rows++;byVideo[k].status=x.status;
  });
  CR_DATA=Object.values(byVideo).map(v=>({...v,roi:v.spend>0?v.revenue/v.spend:0,ctr:v.impressions>0?v.clicks/v.impressions*100:0,cvr:v.rows>0?v.cvr_sum/v.rows:0})).sort((a,b)=>b.revenue-a.revenue);

  const totRev=CR_DATA.reduce((a,x)=>a+x.revenue,0);
  const totSpend=CR_DATA.reduce((a,x)=>a+x.spend,0);
  const avgROI=totSpend>0?totRev/totSpend:0;
  const avgCTR=CR_DATA.length?CR_DATA.reduce((a,x)=>a+x.ctr,0)/CR_DATA.length:0;
  document.getElementById('cr-cnt').textContent=CR_DATA.length.toLocaleString();
  document.getElementById('cr-rev').textContent=fK(totRev);
  const roiEl=document.getElementById('cr-roi');roiEl.textContent=avgROI.toFixed(2)+'x';roiEl.className='kpi-val '+rc(avgROI);
  document.getElementById('cr-ctr').textContent=avgCTR.toFixed(2)+'%';

  // Leaderboard: top creators
  const byCr={};
  CR_DATA.forEach(x=>{if(!byCr[x.username])byCr[x.username]={revenue:0,spend:0,cnt:0};byCr[x.username].revenue+=x.revenue;byCr[x.username].spend+=x.spend;byCr[x.username].cnt++;});
  const topCr=Object.entries(byCr).sort((a,b)=>b[1].revenue-a[1].revenue).slice(0,8);
  const maxRev=topCr[0]?topCr[0][1].revenue:1;
  const avC=['rgba(232,41,74,.12)','rgba(217,119,6,.12)','rgba(37,99,235,.12)','rgba(8,145,178,.12)','rgba(22,163,74,.12)','rgba(124,58,237,.12)','rgba(13,148,136,.12)','rgba(219,39,119,.12)'];
  const avT=['#e8294a','#d97706','#2563eb','#0891b2','#16a34a','#7c3aed','#0d9488','#db2777'];
  document.getElementById('crLeaderboard').innerHTML=topCr.map(([name,v],i)=>{
    const roi=v.spend>0?v.revenue/v.spend:0;
    const barW=Math.round(v.revenue/maxRev*100);
    return`<div style="display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px">
      <span style="font-size:12px;font-weight:700;color:var(--faint);font-family:var(--mono);width:18px;flex-shrink:0;text-align:right">${i+1}</span>
      <div style="width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;flex-shrink:0;background:${avC[i%avC.length]};color:${avT[i%avT.length]}">${name.slice(0,2).toUpperCase()}</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:12px;font-weight:600;color:var(--blue)">@${name}</div>
        <div style="height:5px;background:var(--surface3);border-radius:3px;margin-top:5px;overflow:hidden"><div style="width:${barW}%;height:100%;background:${avT[i%avT.length]};border-radius:3px"></div></div>
      </div>
      <div style="text-align:right;flex-shrink:0">
        <div style="font-size:13px;font-weight:700;font-family:var(--mono);color:var(--green)">${fK(v.revenue)}</div>
        <div style="font-size:10px;color:var(--muted);font-family:var(--mono)">${v.cnt}개 · ROI <span class="${rc(roi)}">${roi.toFixed(1)}x</span></div>
      </div>
    </div>`;
  }).join('');

  renderCreativesTable();
}

function clearCreativeFilters(){
  document.getElementById('cr-filter-username').value='';
  document.getElementById('cr-filter-product').value='';
  renderCreativesTable();
}

function sortCR(key){
  if(CR_SORT.key===key){CR_SORT.dir*=-1;}else{CR_SORT.key=key;CR_SORT.dir=-1;}
  document.querySelectorAll('[id^="cr-sort-"]').forEach(el=>el.textContent='↕');
  const icon=document.getElementById('cr-sort-'+key);if(icon)icon.textContent=CR_SORT.dir>0?'↑':'↓';
  renderCreativesTable();
}

function renderCreativesTable(){
  const fUser=(document.getElementById('cr-filter-username').value||'').toLowerCase().trim();
  const fProd=(document.getElementById('cr-filter-product').value||'').trim();
  let filtered=CR_DATA.filter(x=>
    (!fUser||x.username.toLowerCase().includes(fUser))&&
    (!fProd||x.product_id===fProd)
  );
  filtered=[...filtered].sort((a,b)=>{
    const av=a[CR_SORT.key]??'',bv=b[CR_SORT.key]??'';
    if(typeof av==='string')return CR_SORT.dir*(av.localeCompare(bv));
    return CR_SORT.dir*(av-bv);
  });
  const cnt=document.getElementById('cr-result-count');if(cnt)cnt.textContent=`${filtered.length} results`;

  // 필터 결과 합계
  const sumSpend=filtered.reduce((a,x)=>a+x.spend,0);
  const sumRev=filtered.reduce((a,x)=>a+x.revenue,0);
  const sumOrd=filtered.reduce((a,x)=>a+x.orders,0);
  const sumROI=sumSpend>0?sumRev/sumSpend:0;
  const sumImp=filtered.reduce((a,x)=>a+x.impressions,0);
  const sumClicks=filtered.reduce((a,x)=>a+x.clicks,0);
  const sumCTR=sumImp>0?sumClicks/sumImp*100:0;

  const sumEl=document.getElementById('cr-sum-row');
  if(sumEl){
    sumEl.innerHTML=`
      <div style="display:flex;flex-wrap:wrap;gap:8px 20px;padding:10px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;font-family:var(--mono);font-size:12px">
        <span style="color:var(--muted);font-size:11px;width:100%;letter-spacing:.06em">FILTERED TOTAL (${filtered.length} creatives)</span>
        <span>SPEND <strong>${fK(sumSpend)}</strong></span>
        <span>AD REV <strong style="color:var(--green)">${fK(sumRev)}</strong></span>
        <span>ORDERS <strong>${sumOrd.toLocaleString()}</strong></span>
        <span>ROI <strong class="${rc(sumROI)}">${sumROI.toFixed(2)}x</strong></span>
        <span>IMP <strong>${fN(sumImp)}</strong></span>
        <span>CLICKS <strong>${fN(sumClicks)}</strong></span>
        <span>CTR <strong>${sumCTR.toFixed(2)}%</strong></span>
      </div>`;
  }
  document.getElementById('crBody').innerHTML=filtered.slice(0,50).map(x=>{
    const prodName=PROD_ID_MAP[x.product_id]||x.product_id;
    return`<tr>
      <td style="font-family:var(--mono);font-size:11px;color:var(--muted);white-space:nowrap">${x.video_id}</td>
      <td style="font-size:11px">${tr(shortProdName(prodName),20)}</td>
      <td style="color:var(--blue)">@${x.username}</td>
      <td style="max-width:130px;overflow:hidden;text-overflow:ellipsis" title="${x.title}">${tr(x.title,18)}</td>
      <td>${x.post_date}</td>
      <td>${x.days_since}d</td>
      <td>${fK(x.spend)}</td>
      <td style="color:var(--green);font-weight:600">${fK(x.revenue)}</td>
      <td>${x.orders}</td>
      <td class="${rc(x.roi)}">${x.roi>50?'⚡'+x.roi.toFixed(0)+'x':x.roi.toFixed(2)+'x'}</td>
      <td>${x.impressions?fN(x.impressions):'—'}</td>
      <td>${x.clicks?fN(x.clicks):'—'}</td>
      <td>${x.ctr?x.ctr.toFixed(2)+'%':'—'}</td>
      <td>${x.cvr?x.cvr.toFixed(2)+'%':'—'}</td>
      <td><span class="badge ${x.status==='DELIVERING'?'b-on':x.status==='LEARNING'?'b-blu':'b-off'}">${x.status||'—'}</span></td>
    </tr>`;
  }).join('');
}

