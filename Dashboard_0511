function renderKPITargets(totGMV,dailyData,gmData,r){
  const isKo=lang==='ko';
  const months=[...new Set(dailyData.map(x=>x.date.slice(0,7)))];
  const kpiRow=DATA.kpi.find(k=>months.includes(k.month))||DATA.kpi[DATA.kpi.length-1];
  const totVideos=DATA.allvideos.filter(x=>inR(x.post_date,r)).length; // video count from allvideos
  const uniqCreators=new Set(DATA.allvideos.filter(x=>inR(x.post_date,r)).map(x=>x.username)).size;
  const totAdSpend=gmData.reduce((a,x)=>a+x.spend,0),totAdRev=gmData.reduce((a,x)=>a+x.revenue,0);
  const roi=totAdSpend>0?totAdRev/totAdSpend:0;
  const targets=[
    {lbl:isKo?'GMV 목표':'GMV Target',actual:totGMV,target:kpiRow?.gmv||0,fmt:v=>fK(v)},
    {lbl:isKo?'영상 업로드':'Video Posts',actual:totVideos,target:kpiRow?.video||0,fmt:v=>v.toLocaleString()},
    {lbl:isKo?'활동 크리에이터':'Active Creators',actual:uniqCreators,target:kpiRow?.creator||0,fmt:v=>v.toLocaleString()},
    {lbl:isKo?'ROI 목표':'ROI Target',actual:roi,target:kpiRow?.roi||0,fmt:v=>v.toFixed(2)+'x'},
  ];
  document.getElementById('kpiTargetBars').innerHTML=targets.map(t=>{
    const hasTarget=t.target>0;const pct=hasTarget?Math.min(t.actual/t.target*100,150):0;
    const col=pct>=100?'#4ade80':pct>=70?'#fbbf24':'#f87171';
    return`<div style="background:rgba(255,255,255,.06);border-radius:6px;padding:8px 10px">
      <div style="font-size:10px;color:rgba(255,255,255,.35);font-family:var(--mono);margin-bottom:4px">${t.lbl}</div>
      <div style="font-size:18px;font-weight:700;font-family:var(--mono);color:#fff;line-height:1">${t.fmt(t.actual)}</div>
      ${hasTarget?`<div style="font-size:10px;font-family:var(--mono);color:${col};margin-top:2px">${pct.toFixed(0)}% of ${t.fmt(t.target)}</div>
      <div style="height:3px;background:rgba(255,255,255,.1);border-radius:2px;margin-top:5px;overflow:hidden"><div style="width:${Math.min(pct,100)}%;height:100%;background:${col};border-radius:2px;transition:width .6s"></div></div>`
      :`<div style="font-size:10px;color:rgba(255,255,255,.25);font-family:var(--mono);margin-top:2px">${isKo?'목표 미설정':'No target'}</div>`}
    </div>`;
  }).join('');
}

