<script>
const API_URL='https://script.google.com/macros/s/AKfycbzyxlDZCf8pUmC8O2jWI0DKFOt5PBJoijY_u9vQD1-W7iTT8xeovXfx35Hx1yevWz0/exec';
const TOKEN='eqb-dashboard-2026';
function apiURL(action){return`${API_URL}?token=${TOKEN}&action=${action}&t=${Date.now()}`;}

const FX_FALLBACK=1368;
let DATA={daily:[],orders:[],sample:[],upload:[],video:[],gmvmax:[],kpi:[],gmvtype:[],pl:{},allvideos:[],fx:FX_FALLBACK};
let charts={};
let lang='en';

let GOALS=JSON.parse(localStorage.getItem('eqb_goals')||'{}');
let COSTS=JSON.parse(localStorage.getItem('eqb_costs')||'{}');
let PROD_SETTINGS=JSON.parse(localStorage.getItem('eqb_prod')||JSON.stringify({
  single_kw:'Serum,Cream,Oil,Toner',
  bundle_kw:'Duo,Set,Kit,Bundle',
  lines:[{name:'Vitamin',kw:'Vitamin'},{name:'NAD+',kw:'NAD'},{name:'Bakuchiol',kw:'Bakuchiol'}]
}));

/* ── FX / PST Clock ── */
function tickFX(){
  const kst=new Date(Date.now()+9*3600000);
  document.getElementById('fxTime').textContent=kst.getUTCHours().toString().padStart(2,'0')+':'+kst.getUTCMinutes().toString().padStart(2,'0')+' KST';
  const pst=new Date().toLocaleString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit',hour12:false});
  const pstD=new Date().toLocaleString('en-US',{timeZone:'America/Los_Angeles',month:'short',day:'numeric',weekday:'short'});
  document.getElementById('pstTime').textContent=pst;
  document.getElementById('pstDate').textContent=pstD;
}
tickFX();setInterval(tickFX,30000);

function pF(v){return parseFloat(String(v||'').replace(/[$,₩%\s]/g,''))||0;}
function toDate(v){if(!v)return'';return String(v).slice(0,10);}

/* ── Fetch ── */
async function fetchAction(action){
  const r=await fetch(apiURL(action));
  if(!r.ok)throw new Error(`HTTP ${r.status} (${action})`);
  const json=await r.json();
  if(json.error)throw new Error(`${action}: ${json.error}`);
  return json.rows||[];
}

/* ── Load Data ── */
async function loadData(){
  const btn=document.getElementById('uploadLabel');
  btn.textContent='로딩 중...';
  document.getElementById('uploadOk').style.display='none';
  try{
    const [d,v,o,s,fx,u,gm,kpi,gtype,pl,av]=await Promise.all([
      fetchAction('daily'),fetchAction('video'),fetchAction('orders'),fetchAction('sample'),
      fetchAction('fx'),fetchAction('upload'),fetchAction('gmvmax'),
      fetchAction('kpi'),fetchAction('gmvtype'),fetchAction('pl'),fetchAction('allvideos')
    ]);

    DATA.daily=d.filter(r=>r.date&&r.gmv).map(r=>({
      date:toDate(r.date),gmv:pF(r.gmv),orders:pF(r.orders),aov:pF(r.aov),
      impressions:pF(r.impressions),unique_visits:pF(r.unique_visits),buyers:pF(r.buyers),ctr:pF(r.ctr),cvr:pF(r.cvr)
    })).sort((a,b)=>a.date.localeCompare(b.date));

    DATA.video=v.filter(r=>r.date&&r.username).map(r=>({
      date:toDate(r.date),video_id:r.video_id||'',username:r.username||'',title:r.title||'',
      post_date:toDate(r.video_post_date),days_since:pF(r.days_since_post),
      spend:pF(r.ad_spend),revenue:pF(r.ad_revenue),orders:pF(r.ad_orders),
      roi:pF(r.roi),impressions:pF(r.product_impressions),clicks:pF(r.product_clicks),
      ctr:pF(r.product_ctr),cvr:pF(r.cvr),status:r.creative_delivery_status||'',
      product_id:r.product_id||'',
      roas:pF(r.ad_spend)>0?pF(r.ad_revenue)/pF(r.ad_spend):0
    }));

    DATA.orders=o.filter(r=>r.date&&r.product_name).map(r=>({
      date:toDate(r.date),product_id:r.product_id||'',product_name:r.product_name||'',
      orders_total:pF(r.orders_total),orders_paid:pF(r.orders_paid),orders_sample:pF(r.orders_sample),
      revenue:pF(r.revenue),avg_price:pF(r.avg_price)
    }));

    DATA.sample=s.filter(r=>r.date&&r.product_name).map(r=>({
      date:toDate(r.date),product_id:r.product_id||'',product_name:r.product_name||'',count:pF(r.sample_count)
    }));

    DATA.upload=u.filter(r=>r.date).map(r=>({
      date:toDate(r.date),video_count:pF(r.video_count),creator_count:pF(r.creator_count)
    })).sort((a,b)=>a.date.localeCompare(b.date));

    DATA.gmvmax=gm.filter(r=>r.date&&pF(r.ad_spend)>0).map(r=>({
      date:toDate(r.date),campaign_id:r.campaign_id||'',campaign_name:r.campaign_name||'',
      status:r.operation_status||'',bid_type:r.bid_type||'',roas_bid:pF(r.roas_bid),
      spend:pF(r.ad_spend),revenue:pF(r.ad_revenue),orders:pF(r.ad_orders),
      roas:pF(r.ad_spend)>0?pF(r.ad_revenue)/pF(r.ad_spend):0,cpo:pF(r.cost_per_order)
    }));

    DATA.kpi=kpi.filter(r=>r.Month||r.month).map(r=>({
      month:String(r.Month||r.month||'').slice(0,7),
      gmv:pF(r.GMV||r.gmv),video:pF(r.Video||r.video),
      creator:pF(r.Creator||r.Crator||r.creator||r.crator),roi:pF(r.ROI||r.roi)
    })).filter(r=>r.month);

    DATA.gmvtype=gtype.filter(r=>r.date).map(r=>({
      date:toDate(r.date),
      video_gmv:pF(r.VIDEO_GMV||r.video_gmv),
      product_card_gmv:pF(r.PRODUCT_CARD_GMV||r.product_card_gmv),
      live_gmv:pF(r.LIVE_GMV||r.live_gmv),
      refunds:pF(r.refunds_amount||r.REFUNDS_AMOUNT)
    }));

    const plMap={};
    pl.forEach(r=>{
      const key=String(r.Cost||r.cost||r.item||'').toLowerCase().trim().replace(/\s+/g,'_').replace(/\//g,'');
      const val=pF(r.Ratio||r.ratio||r.rate||r.amount||0);
      if(key)plMap[key]=val;
    });
    DATA.pl=plMap;

    /* All Videos Uploaded: Update_date, video_post_date, video_id, username, title, product_id, product_name, views */
    DATA.allvideos=av.filter(r=>r.video_post_date&&r.video_id).map(r=>({
      update_date:toDate(r.Update_date||r.update_date),
      post_date:toDate(r.video_post_date),
      video_id:String(r.video_id||''),
      username:r.username||'',
      title:r.title||'',
      product_id:String(r.product_id||''),
      product_name:r.product_name||'',
      views:pF(r.views)
    }));

    if(fx.length&&fx[0]){const fv=pF(fx[0].usd_krw_rate||Object.values(fx[0])[1]);if(fv>0)DATA.fx=fv;}
    document.getElementById('fxVal').textContent='₩'+Math.round(DATA.fx).toLocaleString();

    if(DATA.daily.length){
      const dates=DATA.daily.map(r=>r.date);
      const to=dates[dates.length-1];
      const from=fmt(new Date(new Date(to).setDate(new Date(to).getDate()-29)));
      document.getElementById('dateTo').value=to;document.getElementById('dateFrom').value=from;
      const pTo=new Date(from);pTo.setDate(pTo.getDate()-1);
      const pFrom=new Date(pTo);pFrom.setDate(pFrom.getDate()-29);
      document.getElementById('prevTo').value=fmt(pTo);document.getElementById('prevFrom').value=fmt(pFrom);
      // 탭별 min/max 정의 (기준 시트 날짜 사용)
      TAB_DATE_RANGE={
        overview: getDateRange(DATA.daily,'date'),
        products: getDateRange(DATA.orders,'date'),
        funnel:   getDateRange(DATA.gmvtype,'date'),
        pl:       getDateRange(DATA.gmvmax,'date'),
        sample:   getDateRange(DATA.sample,'date'),
        video:    getDateRange(DATA.allvideos,'post_date'),
        ads:      getDateRange(DATA.gmvmax,'date'),
        creatives:getDateRange(DATA.video,'date'),
      };
      applyDateRange('overview');
    }

    document.getElementById('uploadPrompt').style.display='none';
    document.getElementById('dashWrap').style.display='block';
    document.getElementById('uploadOk').style.display='inline';
    document.getElementById('uploadOk').textContent='✓ '+new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})+' 동기화';
    renderAll();
  }catch(e){
    document.getElementById('uploadPrompt').innerHTML=`<div class="up-icon">⚠️</div><div class="up-title">연결 실패</div><div class="up-sub">${e.message}<br><br>Apps Script 배포 상태를 확인해주세요.</div><button class="up-btn" onclick="loadData()">다시 시도</button>`;
    console.error(e);
  }finally{btn.textContent='🔄 Sync';}
}

/* ── Modal helpers ── */
function openModal(id){document.getElementById(id).classList.add('open');}
function closeModal(id){document.getElementById(id).classList.remove('open');}
document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open');}));

function openGoal(){
  const months=[...new Set(DATA.daily.map(r=>r.date.slice(0,7)))].sort();
  if(!months.length){const now=new Date();for(let i=-1;i<=1;i++){const d=new Date(now.getFullYear(),now.getMonth()+i,1);months.push(d.toISOString().slice(0,7));}}
  document.getElementById('goalList').innerHTML=months.map(ym=>{const[y,m]=ym.split('-');return`<div class="modal-row"><span class="modal-lbl">${y}.${m}</span><input class="modal-inp" type="number" id="gi-${ym}" value="${GOALS[ym]||''}" placeholder="0" min="0" step="100"><span class="modal-unit">USD</span></div>`;}).join('');
  openModal('goalModal');
}
function saveGoal(){
  document.querySelectorAll('.modal-inp[id^="gi-"]').forEach(inp=>{const ym=inp.id.replace('gi-','');const v=parseFloat(inp.value)||0;if(v>0)GOALS[ym]=v;else delete GOALS[ym];});
  localStorage.setItem('eqb_goals',JSON.stringify(GOALS));closeModal('goalModal');renderAll();
}

const PL_FIELDS=[
  {id:'cogs',lbl:'COGS (매출원가)',unit:'USD'},{id:'logistics',lbl:'Logistics / Shipping',unit:'USD'},
  {id:'sampling_cogs',lbl:'샘플 COGS',unit:'USD'},{id:'commission_rate',lbl:'Affiliate Commission',unit:'%'},
  {id:'platform_rate',lbl:'Platform Referral Fee',unit:'%',default:6},{id:'agency',lbl:'Agency Fee',unit:'USD'},
];
let curPLMonth='';
function openPL(){const months=[...new Set(DATA.daily.map(r=>r.date.slice(0,7)))].sort();if(!months.length)return;curPLMonth=months[months.length-1];renderPLTabs(months);renderPLInputs();openModal('plModal');}
function renderPLTabs(months){document.getElementById('plMonthTabs').innerHTML=months.map(ym=>`<button onclick="switchPLMonth('${ym}')" id="plt-${ym}" style="font-size:10px;padding:3px 9px;border-radius:4px;cursor:pointer;font-family:var(--mono);background:${ym===curPLMonth?'var(--text)':'transparent'};color:${ym===curPLMonth?'#fff':'var(--muted)'};border:1px solid ${ym===curPLMonth?'var(--text)':'var(--border2)'}">${ym}</button>`).join('');}
function switchPLMonth(ym){PL_FIELDS.forEach(f=>{const el=document.getElementById('pl-inp-'+f.id);if(el){const v=parseFloat(el.value)||0;if(!COSTS[curPLMonth])COSTS[curPLMonth]={};COSTS[curPLMonth][f.id]=v;}});curPLMonth=ym;const months=[...new Set(DATA.daily.map(r=>r.date.slice(0,7)))].sort();renderPLTabs(months);renderPLInputs();}
function renderPLInputs(){const c=COSTS[curPLMonth]||{};const autoSpend=DATA.gmvmax.filter(r=>r.date.slice(0,7)===curPLMonth).reduce((a,r)=>a+r.spend,0);document.getElementById('plInputs').innerHTML=`<div class="modal-section">자동 계산</div><div class="modal-row"><span class="modal-lbl">GMV MAX Ad Spend</span><span style="font-family:var(--mono);font-size:11px;color:var(--muted)">$${autoSpend.toFixed(0)} (자동)</span></div><div class="modal-section">수동 입력 비용</div>${PL_FIELDS.map(f=>`<div class="modal-row"><span class="modal-lbl">${f.lbl}</span><input class="modal-inp" type="number" id="pl-inp-${f.id}" value="${c[f.id]!==undefined?c[f.id]:(f.default||'')}" placeholder="0" min="0" step="${f.unit==='%'?0.1:10}"><span class="modal-unit">${f.unit}</span></div>`).join('')}`;}
function savePL(){PL_FIELDS.forEach(f=>{const el=document.getElementById('pl-inp-'+f.id);if(el){const v=parseFloat(el.value)||0;if(!COSTS[curPLMonth])COSTS[curPLMonth]={};COSTS[curPLMonth][f.id]=v;}});localStorage.setItem('eqb_costs',JSON.stringify(COSTS));closeModal('plModal');renderAll();}

function openProdModal(){document.getElementById('kw-single').value=PROD_SETTINGS.single_kw;document.getElementById('kw-bundle').value=PROD_SETTINGS.bundle_kw;renderLineInputs();openModal('prodModal');}
document.getElementById('prodModal').querySelector('.modal-save').onclick=saveProdSettings;
function renderLineInputs(){document.getElementById('lineInputs').innerHTML=PROD_SETTINGS.lines.map((l,i)=>`<div class="modal-row"><span class="modal-lbl">라인 이름</span><input class="modal-inp" id="ln-name-${i}" value="${l.name}" placeholder="Vitamin" style="width:100px;flex:none"><input class="modal-inp" id="ln-kw-${i}" value="${l.kw}" placeholder="키워드" style="margin-left:4px"><button onclick="removeLine(${i})" style="font-size:10px;color:var(--red);background:none;border:none;cursor:pointer;padding:0 4px">✕</button></div>`).join('');}
function addLine(){PROD_SETTINGS.lines.push({name:'New Line',kw:''});renderLineInputs();}
function removeLine(i){PROD_SETTINGS.lines.splice(i,1);renderLineInputs();}
function saveProdSettings(){PROD_SETTINGS.single_kw=document.getElementById('kw-single').value;PROD_SETTINGS.bundle_kw=document.getElementById('kw-bundle').value;PROD_SETTINGS.lines=PROD_SETTINGS.lines.map((_,i)=>({name:document.getElementById('ln-name-'+i)?.value||'',kw:document.getElementById('ln-kw-'+i)?.value||''}));localStorage.setItem('eqb_prod',JSON.stringify(PROD_SETTINGS));closeModal('prodModal');renderAll();}
function classifyProd(name){const n=name.toUpperCase();const bundleKws=PROD_SETTINGS.bundle_kw.split(',').map(k=>k.trim().toUpperCase()).filter(Boolean);const singleKws=PROD_SETTINGS.single_kw.split(',').map(k=>k.trim().toUpperCase()).filter(Boolean);const isBundle=bundleKws.some(k=>n.includes(k));const isSingle=!isBundle&&singleKws.some(k=>n.includes(k));const line=PROD_SETTINGS.lines.find(l=>l.kw&&n.includes(l.kw.toUpperCase()));return{isBundle,isSingle,line:line?line.name:'Other'};}

/* ── Date utils ── */
function fmt(d){return d instanceof Date?d.toISOString().slice(0,10):d;}
function getR(){return{from:document.getElementById('dateFrom').value,to:document.getElementById('dateTo').value};}
function getPR(){return{from:document.getElementById('prevFrom').value,to:document.getElementById('prevTo').value};}
function inR(d,r){return d>=r.from&&d<=r.to;}
function setQ(days,el){
  document.querySelectorAll('.qbtn').forEach(b=>b.classList.remove('sel'));el.classList.add('sel');
  if(!DATA.daily.length)return;
  const dates=DATA.daily.map(r=>r.date);
  const to=dates[dates.length-1];
  const from=days===90?dates[0]:fmt(new Date(new Date(to).setDate(new Date(to).getDate()-(days-1))));
  document.getElementById('dateTo').value=to;document.getElementById('dateFrom').value=from;
  const cur_from=new Date(from),cur_to=new Date(to);
  const span=Math.round((cur_to-cur_from)/(1000*86400));
  const pTo=new Date(cur_from);pTo.setDate(pTo.getDate()-1);
  const pFrom=new Date(pTo);pFrom.setDate(pFrom.getDate()-span);
  document.getElementById('prevTo').value=fmt(pTo);document.getElementById('prevFrom').value=fmt(pFrom);
  renderAll();
}
[document.getElementById('dateFrom'),document.getElementById('dateTo'),
 document.getElementById('prevFrom'),document.getElementById('prevTo')].forEach(el=>el.addEventListener('change',renderAll));

