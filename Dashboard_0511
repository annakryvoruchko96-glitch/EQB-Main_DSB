<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EQQUALBERRY · TikTok Shop US</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{
  --bg:#F5F6F7;--surface:#fff;--surface2:#EDEEF0;--surface3:#E0E2E5;
  --border:#E0E2E5;--border2:#c8cace;
  --text:#1C1C1C;--muted:#6B7280;--faint:#9CA3AF;
  --accent:#FF5C35;--red:#e8294a;--cyan:#0891b2;--green:#16a34a;--amber:#d97706;
  --blue:#2563eb;--purple:#7c3aed;--teal:#0d9488;--pink:#db2777;
  --vitamin:#d97706;--nad:#db2777;--bakuchiol:#7c3aed;
  --mono:'Pretendard',sans-serif;--sans:'Inter',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg)}
body{font-family:var(--sans);font-size:15px;color:var(--text)}
.shell{display:grid;grid-template-columns:230px 1fr;min-height:100vh}

/* ── SIDEBAR ── */
.sidebar{background:#1C1C1C;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow:hidden}
.sb-logo{padding:18px 18px 14px;border-bottom:1px solid rgba(255,255,255,.08);flex-shrink:0}
.sb-nav{flex:1;overflow-y:auto;overflow-x:hidden}
.sb-brand{font-size:17px;font-weight:700;color:#fff}.sb-brand em{color:#FF5C35;font-style:normal}
.sb-sub{font-size:11px;color:rgba(255,255,255,.32);font-family:var(--mono);margin-top:3px;letter-spacing:.06em}
.sb-sec{font-size:10px;letter-spacing:.16em;color:rgba(255,255,255,.28);padding:14px 18px 5px;font-family:var(--mono)}
.sb-item{display:flex;align-items:center;gap:10px;padding:10px 18px;font-size:14px;color:rgba(255,255,255,.5);cursor:pointer;transition:.12s;border-left:3px solid transparent}
.sb-item:hover{color:#fff;background:rgba(255,255,255,.06)}
.sb-item.active{color:#fff;background:rgba(255,255,255,.09);border-left-color:#FF5C35;font-weight:500}
.sb-item svg{width:15px;height:15px;flex-shrink:0;opacity:.45}.sb-item.active svg{opacity:1}
.sb-bottom{padding:12px 14px 16px;border-top:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;gap:8px;flex-shrink:0}
.fx-block{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:10px 12px}
.fx-label{font-size:10px;letter-spacing:.1em;color:rgba(255,255,255,.3);font-family:var(--mono);margin-bottom:3px}
.fx-val{font-size:19px;font-weight:600;font-family:var(--mono);color:#67e8f9}
.fx-time{font-size:10px;color:rgba(255,255,255,.3);margin-top:2px;font-family:var(--mono);display:flex;align-items:center;gap:4px}
.dot{width:5px;height:5px;border-radius:50%;flex-shrink:0;animation:blink 2s infinite}
.dot.g{background:var(--green)}.dot.a{background:var(--amber)}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

/* ── MAIN ── */
.main{overflow:auto}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:10px 22px;border-bottom:1px solid var(--border);background:var(--surface);position:sticky;top:0;z-index:30;gap:8px;flex-wrap:wrap}
.tb-left{display:flex;align-items:center;gap:10px}
.tb-title{font-size:17px;font-weight:600}
.lang-toggle{display:flex;background:var(--surface2);border:1px solid var(--border);border-radius:5px;overflow:hidden}
.lb{padding:4px 10px;font-size:12px;font-family:var(--mono);cursor:pointer;color:var(--muted);transition:.1s}
.lb.active{background:#1C1C1C;color:#fff;font-weight:500}
.tb-right{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.period-wrap{display:flex;align-items:center;gap:4px}
.period-lbl{font-size:11px;font-family:var(--mono);color:var(--muted);white-space:nowrap}
.date-input{background:var(--surface2);border:1px solid var(--border2);border-radius:5px;color:var(--text);font-family:var(--mono);font-size:12px;padding:5px 7px;outline:none;width:106px}
.date-input:focus{border-color:var(--accent)}
.date-sep{font-size:12px;color:var(--faint)}
.qbtn{font-size:12px;padding:5px 10px;border:1px solid var(--border2);border-radius:5px;color:var(--muted);cursor:pointer;background:transparent;font-family:var(--mono);transition:.1s}
.qbtn.sel,.qbtn:hover{border-color:var(--accent);color:var(--accent)}
.tb-divider{width:1px;height:20px;background:var(--border);flex-shrink:0}
.upload-btn{font-size:13px;padding:6px 13px;border:1px solid var(--border2);border-radius:5px;color:var(--text);cursor:pointer;background:var(--surface);font-family:var(--sans);font-weight:500;display:flex;align-items:center;gap:5px;transition:.1s;white-space:nowrap}
.upload-btn:hover{border-color:var(--accent);color:var(--accent)}
.upload-ok{font-size:12px;font-family:var(--mono);color:var(--green)}

/* ── NOTICE ── */
.notice-bar{background:#fff8f5;border-bottom:1px solid #fdd5c8;padding:6px 22px;font-size:11px;color:#9a3412;font-family:var(--mono);display:flex;align-items:center;gap:6px}

/* ── UPLOAD PROMPT ── */
.upload-prompt{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;gap:14px;text-align:center}
.up-icon{font-size:40px;opacity:.2}
.up-title{font-size:17px;font-weight:600;color:var(--muted)}
.up-sub{font-size:13px;color:var(--faint);line-height:1.7}
.up-btn{font-size:13px;padding:9px 20px;border:1.5px solid var(--accent);border-radius:6px;color:var(--accent);cursor:pointer;background:transparent;font-family:var(--sans);font-weight:600;transition:.1s;margin-top:4px}
.up-btn:hover{background:var(--accent);color:#fff}

/* ── CONTENT ── */
.content{padding:18px 22px;display:flex;flex-direction:column;gap:12px}
.tab-pane{display:none}.tab-pane.active{display:flex;flex-direction:column;gap:12px}

/* ── HERO ── */
.hero{background:#1C1C1C;border-radius:12px;padding:20px 22px;color:#fff;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-50px;right:-30px;width:180px;height:180px;border-radius:50%;background:rgba(255,92,53,.06);pointer-events:none}
.hero-eyebrow{font-size:11px;letter-spacing:.12em;color:rgba(255,255,255,.4);font-family:var(--mono);margin-bottom:12px;font-weight:500}
.hero-goal{margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08)}
.hero-goal-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px}
.hero-goal-lbl{font-size:12px;font-family:var(--mono);color:rgba(255,255,255,.4);letter-spacing:.08em;font-weight:500}
.hero-goal-right{display:flex;align-items:center;gap:6px}
.goal-set-btn{font-size:11px;padding:3px 10px;border:1px solid rgba(255,255,255,.15);border-radius:4px;background:transparent;color:rgba(255,255,255,.4);cursor:pointer;font-family:var(--mono);transition:.1s}
.goal-set-btn:hover{color:#fff;border-color:rgba(255,255,255,.4)}
#kpiTargetBars{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}

/* ── KPIs ── */
.kpis{display:grid;gap:10px}
.k3{grid-template-columns:repeat(3,minmax(0,1fr))}
.k4{grid-template-columns:repeat(4,minmax(0,1fr))}
.k5{grid-template-columns:repeat(5,minmax(0,1fr))}
.k6{grid-template-columns:repeat(6,minmax(0,1fr))}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:15px 16px;position:relative}
.kpi::after{content:'';position:absolute;bottom:0;left:12px;right:12px;height:2.5px;border-radius:1px}
.kr::after{background:var(--red)}.kc::after{background:var(--cyan)}.kg::after{background:var(--green)}
.ka::after{background:var(--amber)}.kp::after{background:var(--purple)}.kb::after{background:var(--blue)}
.kt::after{background:var(--teal)}.kk::after{background:var(--pink)}
.kpi-lbl{font-size:11px;color:var(--muted);letter-spacing:.05em;font-family:var(--mono);margin-bottom:6px;font-weight:500}
.kpi-val{font-size:24px;font-weight:700;font-family:var(--mono);line-height:1}
.kpi-sub{font-size:11px;color:var(--faint);font-family:var(--mono);margin-top:3px;padding-bottom:5px}
.kpi-delta{font-size:11px;font-family:var(--mono);padding-bottom:4px}
.d-up{color:var(--green)}.d-dn{color:var(--red)}.d-neu{color:var(--muted)}

/* ── CARDS ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.g2l{display:grid;grid-template-columns:1.65fr 1fr;gap:12px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px}
.card-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.card-title{font-size:14px;font-weight:600}
.card-meta{font-size:11px;color:var(--muted);font-family:var(--mono)}

/* ── SECTION DESC ── */
.sec-desc{background:var(--surface2);border-left:3px solid var(--accent);border-radius:0 6px 6px 0;padding:10px 14px;font-size:12px;color:var(--muted);line-height:1.6;font-family:var(--mono)}
.sec-desc strong{color:var(--text)}
.sec-desc .note{font-size:11px;color:var(--faint);margin-top:4px}

/* ── INSIGHT ── */
.insight{border-radius:8px;padding:12px 15px;font-size:13px;line-height:1.65;color:var(--muted);border:1px solid}
.ins-b{background:#eff6ff;border-color:#bfdbfe}.ins-b strong{color:var(--blue)}
.ins-g{background:#f0fdf4;border-color:#bbf7d0}.ins-g strong{color:var(--green)}
.ins-a{background:#fffbeb;border-color:#fde68a}.ins-a strong{color:var(--amber)}

/* ── TABLE ── */
.tbl-wrap{overflow-x:auto}
.dt{width:100%;border-collapse:collapse;font-size:12px}
.dt th{text-align:left;font-size:11px;letter-spacing:.04em;color:var(--muted);padding:9px 12px;border-bottom:2px solid var(--border);font-family:var(--mono);font-weight:600;background:var(--surface2);white-space:nowrap}
.dt th.sortable{cursor:pointer;user-select:none}.dt th.sortable:hover{color:var(--accent)}
.dt td{padding:8px 12px;border-bottom:1px solid var(--border);font-family:var(--mono);font-size:12px;color:var(--text);white-space:nowrap;vertical-align:middle}
.dt tr:last-child td{border:none}
.dt tbody tr:hover td{background:var(--surface2)}
.badge{font-size:11px;padding:2px 8px;border-radius:4px;font-weight:600}
.b-on{background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0}
.b-off{background:var(--surface2);color:var(--muted);border:1px solid var(--border)}
.b-bun{background:#fdf4ff;color:#86198f;border:1px solid #f0abfc}
.rg{color:var(--green);font-weight:700}.ra{color:var(--amber);font-weight:700}.rb{color:var(--red);font-weight:700}

/* ── PRODUCT BARS ── */
.pbar-row{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--border)}
.pbar-row:last-child{border:none}
.pbar-name{font-size:12px;font-family:var(--mono);color:var(--muted);width:200px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pbar-track{flex:1;height:18px;background:var(--surface2);border-radius:4px;overflow:hidden}
.pbar-fill{height:100%;border-radius:4px;display:flex;align-items:center;padding-left:7px}
.pbar-fill span{font-size:11px;font-family:var(--mono);color:#fff;font-weight:600;white-space:nowrap}
.pbar-val{font-size:12px;font-family:var(--mono);width:58px;text-align:right;font-weight:500}
.pbar-pct{font-size:12px;font-family:var(--mono);width:34px;text-align:right;color:var(--muted)}

/* ── FILTER BAR ── */
.filter-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:10px 0}
.filter-inp{background:var(--surface2);border:1px solid var(--border2);border-radius:6px;color:var(--text);font-family:var(--mono);font-size:12px;padding:6px 10px;outline:none;width:180px}
.filter-inp:focus{border-color:var(--accent)}
.filter-lbl{font-size:11px;color:var(--muted);font-family:var(--mono)}
.filter-clear{font-size:11px;padding:4px 10px;border:1px solid var(--border2);border-radius:5px;color:var(--muted);cursor:pointer;background:transparent;font-family:var(--mono);transition:.1s}
.filter-clear:hover{border-color:var(--accent);color:var(--accent)}

/* ── FUNNEL ── */
#funnelViz svg{display:block;margin:8px auto 0}

/* ── P&L ── */
.pl-section{font-size:11px;letter-spacing:.1em;color:#fff;font-family:var(--mono);font-weight:700;padding:5px 10px;border-radius:5px;background:#1C1C1C;margin-bottom:10px;margin-top:8px;display:inline-block}
.pl-row{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border)}
.pl-row:last-child{border:none}
.pl-row.total{background:var(--surface2);border-radius:7px;padding:9px 12px;margin-top:6px;border:1px solid var(--border)}
.pl-lbl{font-size:13px;font-family:var(--mono);color:var(--muted)}
.pl-lbl.sub{padding-left:14px;font-size:12px;color:var(--faint)}
.pl-val{font-size:14px;font-family:var(--mono);font-weight:600}
.pl-val.pos{color:var(--green)}.pl-val.neg{color:var(--red)}.pl-val.strong{font-size:19px;font-weight:700}
.pl-pct{font-size:11px;font-family:var(--mono);color:var(--faint);width:42px;text-align:right}

/* ── MODALS ── */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:100;display:none;align-items:center;justify-content:center}
.modal.open{display:flex}
.modal-box{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:24px;width:420px;max-height:82vh;overflow-y:auto;box-shadow:0 24px 80px rgba(0,0,0,.12)}
.modal-title{font-size:17px;font-weight:700;margin-bottom:4px}
.modal-sub{font-size:13px;color:var(--muted);margin-bottom:16px;line-height:1.55}
.modal-section{font-size:10px;letter-spacing:.12em;color:var(--faint);font-family:var(--mono);padding:8px 0 5px;border-bottom:1px solid var(--border);margin-bottom:10px;font-weight:600}
.modal-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.modal-lbl{font-size:12px;color:var(--muted);width:160px;flex-shrink:0;font-family:var(--mono)}
.modal-inp{flex:1;background:var(--surface2);border:1px solid var(--border2);border-radius:6px;color:var(--text);font-family:var(--mono);font-size:13px;padding:6px 9px;outline:none;text-align:right}
.modal-inp:focus{border-color:var(--accent)}
.modal-unit{font-size:12px;color:var(--muted);font-family:var(--mono);width:24px}
.modal-btns{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}
.modal-save{font-size:13px;padding:7px 16px;background:#1C1C1C;color:#fff;border:none;border-radius:6px;cursor:pointer;font-family:var(--sans);font-weight:600}
.modal-save:hover{background:#FF5C35}
.modal-cancel{font-size:13px;padding:7px 13px;background:transparent;color:var(--muted);border:1px solid var(--border2);border-radius:6px;cursor:pointer}

/* ── PRODUCTS KPI layout ── */
.prod-kpis{grid-template-columns:repeat(5,minmax(0,1fr))}
.prod-kpi-full{grid-column:span 1}

@media(max-width:768px){
  .prod-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}
  .prod-kpi-full{grid-column:span 2}
}

/* ── MOBILE ── */
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:49;backdrop-filter:blur(2px)}
.sb-overlay.on{display:block}
.hamburger{display:none;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid var(--border2);border-radius:7px;background:var(--surface);cursor:pointer;flex-shrink:0;transition:.12s}
.hamburger:hover{border-color:var(--accent)}
.hamburger svg{width:18px;height:18px;stroke:var(--text);transition:.12s}
.hamburger:hover svg{stroke:var(--accent)}

@media(max-width:768px){
  /* layout */
  .shell{grid-template-columns:1fr}
  .sidebar{
    position:fixed;left:-240px;top:0;z-index:50;
    width:230px;height:100vh;
    transition:left .26s cubic-bezier(.4,0,.2,1);
  }
  .sidebar.open{left:0;box-shadow:8px 0 32px rgba(0,0,0,.4)}
  .hamburger{display:flex}

  /* topbar */
  .topbar{padding:8px 14px;gap:6px}
  .tb-title{font-size:15px}
  .lang-toggle{display:none}
  /* hide prev period */
  .period-wrap:last-of-type{display:none}
  #prevFrom,#prevTo{display:none}
  .tb-divider{display:none}
  .date-input{width:88px;font-size:11px;padding:4px 5px}
  .period-lbl{font-size:10px;white-space:nowrap}
  .qbtn{font-size:11px;padding:4px 7px}
  .upload-btn{font-size:12px;padding:5px 9px}
  .upload-ok{font-size:11px}

  /* content */
  .content{padding:12px 14px;gap:10px}
  .notice-bar{font-size:10px;padding:5px 14px}

  /* KPI grids */
  .k6{grid-template-columns:repeat(2,minmax(0,1fr))}
  .k4{grid-template-columns:repeat(2,minmax(0,1fr))}
  .k3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .kpis{gap:8px}
  .kpi{padding:12px 13px}
  .kpi-val{font-size:20px}
  .kpi-lbl{font-size:10px}
  .kpi-sub,.kpi-delta{font-size:10px}
  #kpiTargetBars{grid-template-columns:repeat(2,1fr)!important}

  /* cards / grids */
  .g2,.g2l,.g3{grid-template-columns:1fr}
  .card{padding:13px}
  .card-title{font-size:13px}
  .card-meta{font-size:10px}

  /* hero */
  .hero{padding:16px}
  .hero-eyebrow{font-size:10px}

  /* tables */
  .tbl-wrap{-webkit-overflow-scrolling:touch}
  .dt th,.dt td{padding:7px 9px;font-size:11px}

  /* filter */
  .filter-bar{gap:6px;flex-wrap:wrap}
  .filter-inp{width:130px}

  /* sec-desc */
  .sec-desc{font-size:11px}

  /* modal */
  .modal-box{width:calc(100vw - 32px);padding:18px}

  /* product bars */
  .pbar-row{flex-wrap:wrap;gap:6px}
  .pbar-name{width:auto;max-width:160px}
  .pbar-track{min-width:0;flex:1}
}
</style>
</head>
<body>

<!-- Mobile sidebar overlay -->
<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<!-- Goal modal -->
<div class="modal" id="goalModal">
  <div class="modal-box">
    <div class="modal-title">📈 월별 GMV 목표</div>
    <div class="modal-sub">월별 목표 GMV를 USD로 입력하세요.</div>
    <div id="goalList"></div>
    <div class="modal-btns">
      <button class="modal-cancel" onclick="closeModal('goalModal')">취소</button>
      <button class="modal-save" onclick="saveGoal()">저장</button>
    </div>
  </div>
</div>

<!-- P&L Cost modal -->
<div class="modal" id="plModal">
  <div class="modal-box">
    <div class="modal-title">💰 월별 비용 설정</div>
    <div class="modal-sub">P&L 계산에 사용할 월별 비용을 입력하세요.</div>
    <div id="plMonthTabs" style="display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap"></div>
    <div id="plInputs"></div>
    <div class="modal-btns">
      <button class="modal-cancel" onclick="closeModal('plModal')">취소</button>
      <button class="modal-save" onclick="savePL()">저장</button>
    </div>
  </div>
</div>

<!-- Product bundle modal -->
<div class="modal" id="prodModal">
  <div class="modal-box" style="width:460px">
    <div class="modal-title">📦 제품 분류 설정</div>
    <div class="modal-sub">키워드 자동 감지 규칙과 라인 분류를 설정하세요.</div>
    <div class="modal-section">자동 감지 키워드</div>
    <div class="modal-row"><span class="modal-lbl">단품(Single) 키워드</span><input class="modal-inp" id="kw-single" value="Serum,Cream,Oil,Toner"><span class="modal-unit"></span></div>
    <div class="modal-row"><span class="modal-lbl">번들(Bundle) 키워드</span><input class="modal-inp" id="kw-bundle" value="Duo,Set,Kit,Bundle"><span class="modal-unit"></span></div>
