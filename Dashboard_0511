function mk(id,type,labels,datasets,opts={}){
  if(charts[id])charts[id].destroy();
  const ctx=document.getElementById(id);if(!ctx)return;
  charts[id]=new Chart(ctx,{type,data:{labels,datasets},options:{...CB,...opts,plugins:{...CB.plugins,...(opts.plugins||{})},scales:{...CB.scales,...(opts.scales||{})}}});
}

