function closeSidebar(){
  document.querySelector('.sidebar').classList.remove('open');
  document.getElementById('sbOverlay').classList.remove('on');
  document.body.style.overflow='';
}

function showTab(name,el){
  document.querySelectorAll('.tab-pane').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.sb-item').forEach(i=>i.classList.remove('active'));
  document.getElementById('tab-'+name).classList.add('active');
  el.classList.add('active');
  document.getElementById('tabTitle').textContent=el.textContent.trim();
  applyDateRange(name);
  if(window.innerWidth<=768)closeSidebar();
  setTimeout(renderAll,50);
}
function setLang(l,el){lang=l;document.querySelectorAll('.lb').forEach(b=>b.classList.remove('active'));el.classList.add('active');renderAll();}

/* ── Formatters ── */
function fK(n){if(isNaN(n)||n==null)return'—';const abs=Math.abs(n),sign=n<0?'-':'';if(abs>=1e6)return sign+'$'+(abs/1e6).toLocaleString('en',{minimumFractionDigits:2,maximumFractionDigits:2})+'M';if(abs>=1e3)return sign+'$'+(abs/1e3).toLocaleString('en',{minimumFractionDigits:1,maximumFractionDigits:1})+'K';return sign+'$'+abs.toLocaleString('en',{minimumFractionDigits:2,maximumFractionDigits:2});}
function fKRW(n){const w=n*DATA.fx;return w>=1e8?'≈ ₩'+(w/1e8).toFixed(1)+'억':'≈ ₩'+Math.round(w).toLocaleString();}
function fPct(n){return n>=0?'+'+n.toFixed(1)+'%':n.toFixed(1)+'%';}
function tr(s,n=24){return s&&s.length>n?s.slice(0,n)+'…':s||'—';}
function rc(r){return r>=3?'rg':r>=1.5?'ra':'rb';}
function fN(n){if(n>=1e6)return(n/1e6).toFixed(1)+'M';if(n>=1e3)return(n/1e3).toFixed(1)+'K';return n.toLocaleString();}
function delta(cur,prev,el){
  if(!prev||prev===0){if(el){el.textContent='';el.className='kpi-delta';}return null;}
  const pct=(cur-prev)/prev*100;
  if(el){el.textContent=(pct>0?'↑ ':pct<0?'↓ ':'')+fPct(pct)+' vs prev';el.className='kpi-delta '+(pct>0?'d-up':pct<0?'d-dn':'d-neu');}
  return pct;
}

const LINE_COLORS={'Vitamin':'#d97706','NAD+':'#db2777','Bakuchiol':'#7c3aed','Other':'#0891b2'};
function lineCol(lineName){return LINE_COLORS[lineName]||LINE_COLORS['Other'];}
const PCOLS=['#d97706','#db2777','#7c3aed','#0891b2','#16a34a','#e8294a','#2563eb'];
function pcol(i){return PCOLS[i%PCOLS.length];}

const CB={responsive:true,maintainAspectRatio:false,
  plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false}},
